#!/usr/bin/env bash
set -Eeuo pipefail

DEST="root@backup.netbird.cloud"

SSH=(
    ssh
    -o BatchMode=yes
    -o ConnectTimeout=15
    -o ServerAliveInterval=30
    -o ServerAliveCountMax=3
)

DATASETS=(
    audiobooks
    books
    comics
    documentaries
    exercise
    learning
    movies
    music
    photos
    stand-up
    television
)

SYNC_LIMIT="4000k"
LOG="/var/log/syncoid/syncoid.log"

# Prevent overlapping executions of this wrapper.
exec 9>/run/lock/jellyfin-replication.lock
flock -n 9 || exit 0

# Prepare logging before stopping Jellyfin.
mkdir -p "$(dirname "$LOG")"
exec >>"$LOG" 2>&1

log() {
    printf '[%s] %s\n' "$(date -Is)" "$*"
}

restart_needed=0

cleanup() {
    local rc=$?
    trap - EXIT

    if (( restart_needed )); then
        log "Starting destination Jellyfin..."

        if ! "${SSH[@]}" "$DEST" \
            'systemctl start jellyfin.service'; then
            log "ERROR: Could not restart destination Jellyfin."
            rc=1
        fi
    fi

    log "Replication job finished with exit status $rc."
    exit "$rc"
}

trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# Arm cleanup before stopping, in case SSH disconnects after the stop.
restart_needed=1

log "Stopping destination Jellyfin..."
"${SSH[@]}" "$DEST" \
    'systemctl stop jellyfin.service'

for dataset in "${DATASETS[@]}"; do
    log "Syncing storage/$dataset..."

    /usr/sbin/syncoid \
        --no-sync-snap \
        --recvoptions="o compression=zstd" \
        --create-bookmark \
        --compress=none \
        --source-bwlimit="$SYNC_LIMIT" \
        "storage/$dataset" \
        "${DEST}:storage/$dataset"

    log "Finished storage/$dataset."
done

# The EXIT trap starts Jellyfin.
