#!/usr/bin/env bash
set -Eeuo pipefail

UNIT="${1:?Usage: ntfy-unit-failure UNIT}"
: "${NTFY_URL:?NTFY_URL must be configured}"

AUTH=()
if [[ -n "${NTFY_TOKEN:-}" ]]; then
    AUTH=(-H "Authorization: Bearer ${NTFY_TOKEN}")
fi

# Query properties rather than requiring a particular version's
# MONITOR_* environment variables.
DETAILS="$(
    systemctl show "$UNIT" \
        --property=Result \
        --property=ExecMainCode \
        --property=ExecMainStatus
)"

printf -v MESSAGE \
    'Host: %s\nUnit: %s\n\n%s\n\nInspect logs:\njournalctl -u %s -n 100 --no-pager' \
    "$(hostname)" \
    "$UNIT" \
    "$DETAILS" \
    "$UNIT"

curl \
    --fail \
    --silent \
    --show-error \
    --connect-timeout 10 \
    --max-time 30 \
    "${AUTH[@]}" \
    -H "Title: Service failure on $(hostname)" \
    -H "Priority: high" \
    --data-binary "$MESSAGE" \
    "$NTFY_URL" \
    >/dev/null
